# Config del cliente abraunegg/onedrive (contenedor ziegel-onedrive).
# Se copia a /srv/ziegel/onedrive-conf/config. La carpeta se elige con --single-directory (docker-compose.yml).
sync_dir = "/onedrive/data"
# Mínimo que permite el cliente: 300 s (lo que cambia en las PCs baja en ≤5 min; lo del servidor sube al instante).
monitor_interval = "300"
threads = "2"
enable_logging = "true"
log_dir = "/onedrive/conf/logs/"
# Freno de borrados masivos: si de golpe desaparecen más de 200 archivos, no borra y avisa.
classify_as_big_delete = "200"
# Nunca sube basura de Windows/temporales de escritura atómica.
skip_file = "~*|.~*|*.tmp|*.swp|*.partial|desktop.ini|Thumbs.db"
